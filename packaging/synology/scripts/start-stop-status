#!/bin/sh
set -eu
umask 077
PKG_NAME="${SYNOPKG_PKGNAME:-SynologyNASConnector}"
PKG_TARGET="${SYNOPKG_PKGDEST:-/var/packages/$PKG_NAME/target}"
PKG_VAR="${SYNOPKG_PKGVAR:-/var/packages/$PKG_NAME/var}"
PID_FILE="$PKG_VAR/service.pid"
is_running() {
  [ -f "$PID_FILE" ] || return 1
  PID=$(cat "$PID_FILE")
  case "$PID" in ''|*[!0-9]*) return 1 ;; esac
  [ "$PID" -gt 1 ] || return 1
  kill -0 "$PID" 2>/dev/null || return 1
  # Refuse stale/reused PIDs; require the exact package bundle argument.
  [ -r "/proc/$PID/cmdline" ] || return 1
  tr '\000' '\n' < "/proc/$PID/cmdline" | grep -Fx "$PKG_TARGET/server.cjs" >/dev/null
}
case "${1:-}" in
  start)
    if is_running; then exit 0; fi
    . "$PKG_TARGET/bin/node-runtime"
    find_node
    mkdir -p "$PKG_VAR"
    cd "$PKG_TARGET"
    NAS_CONNECTOR_UI_DIR="$PKG_TARGET/ui" export NAS_CONNECTOR_UI_DIR
    "$NODE" "$PKG_TARGET/server.cjs" --config "$PKG_VAR/config.json" >> "$PKG_VAR/service.log" 2>&1 &
    echo "$!" > "$PID_FILE"
    sleep 1
    is_running || { echo 'Connector failed to start; inspect private service.log' >&2; exit 1; }
    ;;
  stop)
    if is_running; then
      kill "$PID"
      attempts=0
      while is_running && [ "$attempts" -lt 10 ]; do sleep 1; attempts=$((attempts + 1)); done
      if is_running; then echo 'Connector did not stop cleanly' >&2; exit 1; fi
    fi
    rm -f "$PID_FILE"
    ;;
  status) is_running && exit 0; exit 1 ;;
  log) echo "$PKG_VAR/service.log" ;;
  *) echo 'Usage: start-stop-status {start|stop|status|log}' >&2; exit 1 ;;
esac
