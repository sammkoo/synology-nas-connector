{
  "name": "synology-nas-connector", "version": "0.1.0", "private": true,
  "description": "Read-only Synology NAS MCP connector for ChatGPT and local MCP clients",
  "license": "MIT", "type": "module", "engines": {"node": ">=22 <25"},
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run test:bundle",
    "test:bundle": "node scripts/smoke-bundle.mjs",
    "dev": "tsx watch apps/server/src/cli.ts",
    "start": "node dist/server.cjs",
    "init": "node scripts/init-config.mjs",
    "spk": "python3 scripts/build-spk.py",
    "test:spk": "python3 scripts/test-spk.py"
  },
  "dependencies": {"@modelcontextprotocol/sdk": "1.31.0", "express": "^5.1.0", "zod": "^3.25.76"},
  "devDependencies": {"@types/express": "^5.0.3", "@types/node": "^22.18.0", "esbuild": "^0.25.10", "tsx": "^4.20.5", "typescript": "^5.9.2"}
}
